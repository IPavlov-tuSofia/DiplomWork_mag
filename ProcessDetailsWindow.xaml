<Window x:Class="DiplomWork_Ivan_2026.ProcessDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Details"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#595959"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WindowTitleTextBlock" Text="Vacuum Dryer Process Details"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="CLOSE"
                    Width="100"
                    Height="35"
                    Background="#B71C1C"
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Process Variables -->
            <GroupBox Header="Process Variables"
                      Grid.Row="0"
                      Grid.Column="0"
                      Margin="0,0,10,10"
                      Background="#3A3A3A"
                      Foreground="White"
                      BorderBrush="#777"
                      FontSize="16">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="15">
                        <TextBlock x:Name="ChamberTemperatureTextBlock" Foreground="OrangeRed" FontSize="16"/>
                        <TextBlock x:Name="MaterialTemperatureTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TemperatureSetpointTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PressureTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PressureSetpointTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="VacuumLevelTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="AirHumidityTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="VaporPressureTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="MaterialMoistureTextBlock" Foreground="LimeGreen" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="EquilibriumMoistureTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="MoistureRatioTextBlock" Foreground="LimeGreen" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DryingRateTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                        <TextBlock x:Name="AirFlowRateTextBlock" Foreground="LimeGreen" FontSize="16" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- Material Data -->
            <GroupBox Header="Material Data"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="10,0,0,10"
                      Background="#3A3A3A"
                      Foreground="White"
                      BorderBrush="#777"
                      FontSize="16">

                <StackPanel Margin="15">
                    <TextBlock x:Name="MaterialNameTextBlock" Foreground="White" FontSize="16"/>
                    <TextBlock x:Name="InitialMoistureTextBlock" Foreground="LimeGreen" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TargetMoistureTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="MaxTemperatureTextBlock" Foreground="OrangeRed" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DryingCoefficientTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="MaterialMassTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Energy Data -->
            <GroupBox Header="Energy / Efficiency"
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,10,10,0"
                      Background="#3A3A3A"
                      Foreground="White"
                      BorderBrush="#777"
                      FontSize="16">

                <StackPanel Margin="15">
                    <TextBlock x:Name="TotalEnergyTextBlock" Foreground="MediumPurple" FontSize="16"/>
                    <TextBlock x:Name="EvaporatedWaterTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PumpedVaporTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CondensedWaterTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="VaporBalanceTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="EfficiencyTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ElapsedTimeTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="RemainingTimeTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Actuators -->
            <GroupBox Header="Actuators"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="10,10,0,0"
                      Background="#3A3A3A"
                      Foreground="White"
                      BorderBrush="#777"
                      FontSize="16">

                <StackPanel Margin="15">
                    <TextBlock x:Name="HeaterPowerTextBlock" Foreground="OrangeRed" FontSize="16"/>
                    <TextBlock x:Name="PumpPowerTextBlock" Foreground="DeepSkyBlue" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="VentValveTextBlock" Foreground="Gold" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="FanSpeedTextBlock" Foreground="LimeGreen" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ProcessStageTextBlock" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="SensorStatusTextBlock" Foreground="#00FF00" FontSize="16" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ProcessStatusTextBlock" Foreground="#00FF00" FontSize="16" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
