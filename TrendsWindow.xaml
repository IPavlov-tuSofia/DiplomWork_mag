<Window x:Class="DiplomWork_Ivan_2026.TrendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Trends"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#595959"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WindowTitleTextBlock" Text="Vacuum Dryer Process Trends"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="ZoomButton"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#455A64"
                        Foreground="White"
                        FontWeight="Bold"
                        ToolTip="Activate rectangle zoom. Drag over the chart to zoom in."
                        Click="ZoomButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50D;"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="16"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="ZOOM"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ResetZoomButton"
                        Content="RESET"
                        Width="75"
                        Height="40"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Background="#616161"
                        Foreground="White"
                        FontWeight="Bold"
                        ToolTip="Reset the chart zoom."
                        Click="ResetZoomButton_Click"/>

                <Button x:Name="ExportCsvButton"
                        Content="EXPORT CSV"
                        Width="145"
                        Height="40"
                        Margin="0,0,15,0"
                        Background="#1976D2"
                        Foreground="White"
                        FontWeight="Bold"
                        ToolTip="Export all stored raw process samples to a CSV file."
                        Click="ExportCsvButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="CLOSE"
                        Width="100"
                        Height="40"
                        Background="#B71C1C"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="1"
                Background="#252525"
                BorderBrush="#555"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Selected trend:"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="TrendComboBox"
                          Grid.Column="1"
                          Height="32"
                          FontSize="15"
                          SelectedIndex="0"
                          SelectionChanged="TrendComboBox_SelectionChanged">
                    <ComboBoxItem Content="Temperature"/>
                    <ComboBoxItem Content="Pressure"/>
                    <ComboBoxItem Content="Moisture / Humidity"/>
                    <ComboBoxItem Content="Drying Rate"/>
                    <ComboBoxItem Content="Actuators"/>
                    <ComboBoxItem Content="Energy"/>
                </ComboBox>

                <TextBlock Grid.Column="3"
                           Text="Time range:"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="TimeRangeComboBox"
                          Grid.Column="4"
                          Height="32"
                          FontSize="15"
                          SelectedIndex="0"
                          SelectionChanged="TimeRangeComboBox_SelectionChanged">
                    <ComboBoxItem Content="10 min" Tag="600"/>
                    <ComboBoxItem Content="1 h" Tag="3600"/>
                    <ComboBoxItem Content="4 h" Tag="14400"/>
                    <ComboBoxItem Content="All" Tag="All"/>
                </ComboBox>

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Display:"
                               Foreground="White"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="DisplayModeComboBox"
                              Width="130"
                              Height="32"
                              FontSize="15"
                              SelectedIndex="0"
                              SelectionChanged="DisplayModeComboBox_SelectionChanged"
                              ToolTip="Changes only the chart appearance; stored process data is not modified.">
                        <ComboBoxItem Content="Raw"/>
                        <ComboBoxItem Content="Smooth"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="CurrentValueTextBlock"
                           Grid.Column="6"
                           Text="Current: 0.0"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- Main chart -->
        <Border Grid.Row="2"
                Background="#252525"
                BorderBrush="#777"
                BorderThickness="1"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChartTitleTextBlock"
                           Text="Temperature [°C]"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Canvas x:Name="MainTrendCanvas"
                        Grid.Row="1"
                        Background="#1E1E1E"
                        MouseLeftButtonDown="MainTrendCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="MainTrendCanvas_MouseLeftButtonUp"
                        MouseRightButtonDown="MainTrendCanvas_MouseRightButtonDown"
                        MouseMove="MainTrendCanvas_MouseMove"
                        MouseLeave="MainTrendCanvas_MouseLeave"/>
            </Grid>
        </Border>
    </Grid>
</Window>
