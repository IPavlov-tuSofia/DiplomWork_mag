<Window x:Class="DiplomWork_Ivan_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SCADA - Vacuum Dryer"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#595959">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT CONTROL PANEL -->
        <Border Grid.Column="0"
                Background="#2B2B2B"
                BorderBrush="#555"
                BorderThickness="1"
                Padding="15"
                CornerRadius="6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Vacuum Dryer Control"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Material:" Foreground="White"/>
                    <ComboBox x:Name="MaterialComboBox"
                              Height="30"
                              Margin="0,0,0,10"
                              SelectionChanged="MaterialComboBox_SelectionChanged"/>

                    <TextBlock Text="Temperature Setpoint [°C]:"
                               Foreground="White"/>
                    <TextBox x:Name="TemperatureSetpointTextBox"
                             Text="60"
                             Height="28"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Pressure Setpoint [kPa]:"
                               Foreground="White"/>
                    <TextBox x:Name="PressureSetpointTextBox"
                             Text="30"
                             Height="28"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Operation Mode:"
                               Foreground="White"/>
                    <ComboBox x:Name="OperationModeComboBox"
                              Height="30"
                              Margin="0,0,0,15"
                              SelectedIndex="0"
                              SelectionChanged="OperationModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Manual"/>
                    </ComboBox>
                    <TextBlock Text="Temperature Control:"
                               Foreground="#E0E0E0"
                               Margin="0,10,0,0"/>

                    <ComboBox x:Name="TemperatureControlComboBox"
                              Height="30"
                              SelectedIndex="1"
                              SelectionChanged="TemperatureControlComboBox_SelectionChanged">
                        <ComboBoxItem Content="ON/OFF"/>
                        <ComboBoxItem Content="PID"/>
                    </ComboBox>
                    <TextBlock Text="Drying Mode:"
                               Foreground="White"
                               Margin="0,10,0,0"/>

                    <ComboBox x:Name="DryingModeComboBox"
                              Height="30"
                              Margin="0,0,0,10"
                              SelectedIndex="1"
                              SelectionChanged="DryingModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Soft"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Hard"/>
                    </ComboBox>

                    <TextBlock x:Name="DryingRecipeInfoTextBlock"
                               Text="Select a material and drying mode."
                               Foreground="#BDBDBD"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <Border Margin="0,15,0,0" Padding="10"
                            BorderBrush="#455A64" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Process control" Foreground="White"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="StartButton"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="Start"
                                Height="42"
                                FontWeight="Bold"
                                Margin="0"
                                Click="StartButton_Click">

                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#1B5E20"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#111111"/>
                                                    <Setter Property="Foreground" Value="#777777"/>
                                                    <Setter Property="BorderBrush" Value="#333333"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="StopButton"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="Pause"
                                Height="42"
                                FontWeight="Bold"
                                Background="#455A64"
                                Foreground="White"
                                Margin="0"
                                Visibility="Collapsed"
                                ToolTip="Pause the simulation and set all actuator outputs to zero. The batch can be resumed."
                                Click="StopButton_Click"/>
                            </Grid>

                            <!-- RESET button under START / STOP -->
                            <Button x:Name="ResetButton"
                        Content="Reset Process"
                        Height="42"
                        FontWeight="Bold"
                        Background="#455A64"
                        Foreground="White"
                        Margin="0,10,0,0"
                        Visibility="Collapsed"
                        ToolTip="Clear the current batch progress and trend history."
                        Click="ResetButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="10"
                            BorderBrush="#8E2424" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Safety" Foreground="White"
                               FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SafetyStateTextBlock"
                               Text="Safety state: Normal" Foreground="#00FF00"
                               FontSize="12" Margin="0,2,0,8"/>
                            <Button x:Name="EmergencyStopButton"
                            Content="EMERGENCY STOP"
                            Height="48"
                            FontWeight="Bold"
                            Background="#B71C1C"
                            Foreground="White"
                            Margin="0"
                            Click="EmergencyStopButton_Click"/>

                            <Button x:Name="ResetSafetyButton"
                            Content="Reset Safety"
                            Height="38"
                            FontWeight="Bold"
                            Background="#F9A825"
                            Foreground="White"
                            Margin="0,8,0,0"
                            Visibility="Collapsed"
                            ToolTip="Available after a safety trip and only when safe reset conditions are met."
                            Click="ResetSafetyButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT HMI AREA -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="304*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="31.4"/>
                <RowDefinition Height="138.6"/>
            </Grid.RowDefinitions>

            <!-- STATUS HEADER -->
            <Border Grid.Row="0"
            Background="#252525"
            CornerRadius="5"
            Padding="15"
            Margin="-4,0,14,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="0"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <Run x:Name="StatusLabelRun" Text="Status: " Foreground="White"/>
                        <Run x:Name="StatusValueRun" Text="Ready" Foreground="#B0BEC5"/>
                    </TextBlock>

                    <TextBlock x:Name="ProcessStageTextBlock"
                               Grid.Column="1"
                               Text="Stage: Idle"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" Width="203"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Simulation speed:"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="SimulationSpeedComboBox"
                                  Width="85"
                                  Height="32"
                                  FontSize="15"
                                  SelectedIndex="0"
                                  SelectionChanged="SimulationSpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="1×" Tag="1"/>
                            <ComboBoxItem Content="10×" Tag="10"/>
                            <ComboBoxItem Content="60×" Tag="60"/>
                            <ComboBoxItem Content="600×" Tag="600"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HMI PROCESS DIAGRAM -->
            <Border Grid.Row="1"
                    Background="#252525"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="-4,15,14,15" Grid.RowSpan="2">

                <Grid>
                    <Canvas>
                        <TextBlock x:Name="TimeTextBlock"
                               Canvas.Left="15" Canvas.Top="15"
                               Text="Elapsed: 00:00:00"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                        <!-- Цялата схема - за бързо преместване -->
                        <Canvas Canvas.Left="0" Canvas.Top="70"
                            Width="850" Height="500">
                            <!-- Process lines are drawn first so they remain behind the equipment. -->
                            <Line Canvas.Left="152" Canvas.Top="150" X1="0" Y1="0" X2="195" Y2="0"
                               Stroke="#CC3300" StrokeThickness="6" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Line Canvas.Left="275" Canvas.Top="304" X1="0" Y1="0" X2="70" Y2="0"
                               Stroke="#78909C" StrokeThickness="6"/>
                            <Path Data="M 80,150 L 25,150 L 25,305 L 215,305"
                                  Stroke="#78909C" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                            <Line Canvas.Left="490" Canvas.Top="205" X1="0" Y1="0" X2="125" Y2="0"
                              Stroke="#4FC3F7" StrokeThickness="8" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Line Canvas.Left="766" Canvas.Top="203" X1="0" Y1="0" X2="55" Y2="0"
                              Stroke="#4FC3F7" StrokeThickness="6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Line Canvas.Left="425" Canvas.Top="54" X1="0" Y1="0" X2="0" Y2="42"
                               Stroke="#B0BEC5" StrokeThickness="4"/>

                            <!-- Flow direction: chamber return -> fan -> heater -> chamber supply. -->
                            <Polygon Canvas.Left="315" Canvas.Top="299"
                                     Points="12,0 0,6 12,12" Fill="#B0BEC5"/>
                            <Polygon Canvas.Left="19" Canvas.Top="218"
                                     Points="0,12 6,0 12,12" Fill="#B0BEC5"/>
                            <Polygon Canvas.Left="42" Canvas.Top="144"
                                     Points="0,0 12,6 0,12" Fill="#B0BEC5"/>
                            <Polygon Canvas.Left="258" Canvas.Top="144"
                                     Points="0,0 12,6 0,12" Fill="#CC3300" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <TextBlock Canvas.Left="768" Canvas.Top="172"
                                   Text="Vacuum line" Foreground="LightGray" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <!-- Neutral equipment symbols; live state remains in the lamps and indicators. -->
                            <Image Canvas.Left="55" Canvas.Top="117" Width="145" Height="90"
                               Source="/Assets/Hmi/electric_heater.png" Stretch="Uniform"
                               Opacity="0.82" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <TextBlock Canvas.Left="108" Canvas.Top="160" Text="EH-101"
                                   Foreground="#CFD8DC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <Image Canvas.Left="195" Canvas.Top="255" Width="105" Height="100"
                               Source="/Assets/Hmi/circulation_fan.png" Stretch="Uniform"
                               Opacity="0.82" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Canvas.Left="232" Canvas.Top="341" Text="F-101"
                                   Foreground="#CFD8DC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <Border Canvas.Left="305" Canvas.Top="72" Width="240" Height="292"
                                 ClipToBounds="True" IsHitTestVisible="False">
                                <Image Width="420" Height="292"
                                   Source="/Assets/Hmi/vacuum_chamber.png" Stretch="Fill"
                                   Opacity="0.72" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Hide the unused center-left nozzle from the source artwork. -->
                            <Rectangle Canvas.Left="295" Canvas.Top="188" Width="53" Height="34"
                                       Fill="#252525"/>

                            <!-- Dedicated hot-air inlet and circulation-return outlet. -->
                            <Line Canvas.Left="330" Canvas.Top="150" X1="0" Y1="0" X2="18" Y2="0"
                                  Stroke="#B0BEC5" StrokeThickness="8"/>
                            <Rectangle Canvas.Left="327" Canvas.Top="139" Width="6" Height="22"
                                       Fill="#CFD8DC" Stroke="#455A64" StrokeThickness="1"/>
                            <Line Canvas.Left="330" Canvas.Top="305" X1="0" Y1="0" X2="18" Y2="0"
                                  Stroke="#B0BEC5" StrokeThickness="8"/>
                            <Rectangle Canvas.Left="327" Canvas.Top="294" Width="6" Height="22"
                                       Fill="#CFD8DC" Stroke="#455A64" StrokeThickness="1"/>

                            <!-- Independent equipment tag; move it with Canvas.Left / Canvas.Top. -->
                            <TextBlock Canvas.Left="331" Canvas.Top="139" Width="188"
                                       Text="V-101" Foreground="#CFD8DC" FontSize="20"
                                       FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                            <!-- Chamber measurements intentionally stay inside the vessel. -->
                            <StackPanel Canvas.Left="331" Canvas.Top="118" Width="188">
                                <!-- Layout placeholder preserves the exact indicator positions. -->
                                <TextBlock Text="V-101" Visibility="Hidden" FontSize="11"
                                           FontWeight="SemiBold"/>
                                <!-- Hidden retains the original layout height so the indicators do not move. -->
                                <TextBlock Text="VACUUM DRYER" Visibility="Hidden"
                                           FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="CHAMBER" Visibility="Hidden" FontSize="12"/>
                                <Separator Margin="12,4" Background="#666"/>
                                <Border Width="158" Height="25" Margin="0,1" Background="#151515"
                                    BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                    <TextBlock x:Name="TemperatureTextBlock"
                                           Text="Chamber T   20.0 °C" Foreground="OrangeRed"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="158" Height="25" Margin="0,1" Background="#151515"
                                    BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                    <TextBlock x:Name="MaterialTemperatureTextBlock"
                                           Text="Material T   20.0 °C" Foreground="Gold"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="158" Height="25" Margin="0,1" Background="#151515"
                                    BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                    <TextBlock x:Name="PressureTextBlock"
                                           Text="Pressure   101.3 kPa" Foreground="DeepSkyBlue"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="158" Height="25" Margin="0,1" Background="#151515"
                                    BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                    <TextBlock x:Name="MoistureTextBlock"
                                           Text="Moisture   60.0 % wb" Foreground="LimeGreen"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Image Canvas.Left="598" Canvas.Top="137" Width="180" Height="130"
                               Source="/Assets/Hmi/vacuum_pump.png" Stretch="Uniform"
                               Opacity="0.82" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Canvas.Left="649" Canvas.Top="251" Text="VP-101"
                                   Foreground="#CFD8DC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <Image Canvas.Left="395" Canvas.Top="-18" Width="96" Height="78"
                               Source="/Assets/Hmi/vent_valve.png" Stretch="Uniform"
                               Opacity="0.82" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Image.RenderTransform>
                            </Image>
                            <TextBlock Canvas.Left="433" Canvas.Top="-59" Text="XV-101"
                                   Foreground="#CFD8DC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <Ellipse x:Name="VentValveLamp"
                             Canvas.Left="372"
                             Canvas.Top="-31"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!-- Status lamps -->
                            <Ellipse x:Name="HeaterLamp"
                             Canvas.Left="50"
                             Canvas.Top="192"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                            <Ellipse x:Name="FanLamp"
                             Canvas.Left="159"
                             Canvas.Top="370"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                            <Ellipse x:Name="PumpLamp"
                             Canvas.Left="595"
                             Canvas.Top="280"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <!-- Digital HMI indicators: one live value per field -->
                            <Border Canvas.Left="80" Canvas.Top="184" Width="145" Height="38"
                            Background="#151515" BorderBrush="White"
                            BorderThickness="1.5" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock x:Name="HeaterOutputIndicatorTextBlock"
                                   Text="Power   0 %" Foreground="OrangeRed"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Canvas.Left="190" Canvas.Top="362" Width="126" Height="38"
                            Background="#151515" BorderBrush="White"
                            BorderThickness="1.5" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock x:Name="FanOutputIndicatorTextBlock"
                                   Text="Speed   0 %" Foreground="LimeGreen"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Canvas.Left="626" Canvas.Top="274" Width="130" Height="38"
                            Background="#151515" BorderBrush="White"
                            BorderThickness="1.5" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="PumpOutputIndicatorTextBlock"
                                   Text="Power   0 %" Foreground="DeepSkyBlue"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Canvas.Left="399" Canvas.Top="-36" Width="120" Height="32"
                            Background="#151515" BorderBrush="White"
                            BorderThickness="1.5" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="VentOutputIndicatorTextBlock"
                                   Text="Open   0 %" Foreground="Gold"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>


                            <Rectangle Canvas.Left="306" Canvas.Top="72" Width="240" Height="292"
                               Fill="#01000000" Cursor="Hand" Tag="Chamber"
                               ToolTip="Show chamber measurements and state"
                               MouseLeftButtonDown="ProcessObject_MouseLeftButtonDown" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Rectangle Canvas.Left="45" Width="180" Height="132"
                               Fill="#01000000" Cursor="Hand" Tag="Heater"
                               ToolTip="Show heater information"
                               MouseLeftButtonDown="ProcessObject_MouseLeftButtonDown" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="105"/>
                            <Rectangle Canvas.Left="188" Canvas.Top="250" Width="130" Height="148"
                               Fill="#01000000" Cursor="Hand" Tag="Fan"
                               ToolTip="Show circulation fan information"
                               MouseLeftButtonDown="ProcessObject_MouseLeftButtonDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Canvas.Left="588" Canvas.Top="132" Width="190" Height="184"
                               Fill="#01000000" Cursor="Hand" Tag="Pump"
                               ToolTip="Show vacuum pump information"
                               MouseLeftButtonDown="ProcessObject_MouseLeftButtonDown"/>
                            <Rectangle Canvas.Left="360" Canvas.Top="-61" Width="185" Height="115"
                               Fill="#01000000" Cursor="Hand" Tag="Vent"
                               ToolTip="Show vent valve information"
                               MouseLeftButtonDown="ProcessObject_MouseLeftButtonDown" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        </Canvas>
                    </Canvas>
                    <StackPanel Margin="0,12,12,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10">
                        <Image x:Name="LanguageFlagImage"
                               Source="/Assets/Flags/bg_flag.png"
                               Width="50"
                               Height="38"
                               Margin="0,0,8,0"
                               Stretch="Uniform"/>

                        <Button x:Name="LanguageButton"
                                Content="Български"
                                Width="152"
                                Height="38"
                                Background="#455A64"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="LanguageButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- BOTTOM MEASUREMENTS PANEL -->
            <Border Grid.Row="3"
                        Background="#2B2B2B"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15" Grid.RowSpan="2" Margin="-4,0,14,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Process progress -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Process Progress"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="RemainingTimeTextBlock"
                                   Text="Estimated Remaining: calculating..."
                                   Foreground="White" FontSize="15"/>
                        <TextBlock x:Name="SensorStatusTextBlock" Text="Sensors: OK"
                                   Foreground="#00FF00" FontSize="15"/>
                    </StackPanel>

                    <!-- Batch performance: no duplicated live PV/SP values -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Batch Performance"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="MoistureRatioTextBlock"
                       Text="Moisture Ratio: 1.000"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="VacuumLevelTextBlock"
                       Text="Vacuum Level: 0.0 %"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="TotalEnergyTextBlock"
                       Text="Total Energy: 0.000 kWh"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="EfficiencyTextBlock"
                       Text="Efficiency: 0.000 kg/kWh"
                       Foreground="White"
                       FontSize="15"/>

                    </StackPanel>

                    <!-- Alarms -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Active Alarm"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="AlarmsTextBlock"
                       Text="No active alarms"
                       Foreground="#00FF00"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!-- RIGHT SIDE PANEL -->
        <Border Grid.Column="2"
                        Background="#252525"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="Navigation"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1">

                    <Button x:Name="DetailsButton"
                    Content="DETAILS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#1976D2"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="DetailsButton_Click"/>

                    <Button x:Name="ShowTrendsButton"
                    Content="TRENDS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#1976D2"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="ShowTrendsButton_Click"/>

                    <Button x:Name="ShowAlarmsButton"
                    Content="ALARMS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#1976D2"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="ShowAlarmsButton_Click"/>
                </StackPanel>

                <GroupBox Grid.Row="2"
                  Header="Context / Controls"
                  Foreground="White"
                  BorderBrush="#777"
                  Margin="0,20,0,20"
                  Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ContextPanelTitleTextBlock"
                                       Text="Vacuum Chamber"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="SelectedObjectStatusTextBlock"
                                       Text="State: Ready"
                                       Foreground="#00FF00"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <StackPanel x:Name="ContextValuesPanel" Margin="0,0,0,10">
                                <TextBlock x:Name="ContextValue1TextBlock" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock x:Name="ContextValue2TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ContextValue3TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ContextValue4TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ContextValue5TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ContextValue6TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ContextValue7TextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="ControllerSettingsButton"
                                    Content="CONTROLLER SETTINGS"
                                    Height="34"
                                    Margin="0,0,0,10"
                                    Background="#455A64"
                                    BorderBrush="#78909C"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Visibility="Collapsed"
                                    Click="ControllerSettingsButton_Click"/>
                            <Separator Background="#555" Margin="0,0,0,10"/>
                            <TextBlock Text="Actuator outputs"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="ContextPanelModeTextBlock"
                                       Text="Auto mode: controller outputs"
                                       Foreground="LightGray"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>

                            <StackPanel x:Name="AutoOutputsPanel">
                                <TextBlock Text="Heater Power" Foreground="White"/>
                                <TextBlock x:Name="AutoHeaterValueTextBlock" Text="0 %"
                                           Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                                <ProgressBar x:Name="AutoHeaterProgressBar" Minimum="0" Maximum="100"
                                             Height="8" Margin="0,2,0,12"/>
                                <TextBlock Text="Vacuum Pump" Foreground="White"/>
                                <TextBlock x:Name="AutoPumpValueTextBlock" Text="0 %"
                                           Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                                <ProgressBar x:Name="AutoPumpProgressBar" Minimum="0" Maximum="100"
                                             Height="8" Margin="0,2,0,12"/>
                                <TextBlock Text="Vent Valve" Foreground="White"/>
                                <TextBlock x:Name="AutoVentValveValueTextBlock" Text="0 %"
                                           Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                                <ProgressBar x:Name="AutoVentValveProgressBar" Minimum="0" Maximum="100"
                                             Height="8" Margin="0,2,0,12"/>
                                <TextBlock Text="Fan Speed" Foreground="White"/>
                                <TextBlock x:Name="AutoFanValueTextBlock" Text="70 %"
                                           Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                                <ProgressBar x:Name="AutoFanProgressBar" Minimum="0" Maximum="100"
                                             Height="8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ManualControlsPanel" Visibility="Collapsed">
                                <TextBlock Text="Heater Power [%]" Foreground="White"/>
                                <TextBlock x:Name="ManualHeaterValueTextBlock" Text="0 %" Foreground="LightGray"/>
                                <Slider x:Name="ManualHeaterSlider" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="ManualSlider_ValueChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="Vacuum Pump [%]" Foreground="White"/>
                                <TextBlock x:Name="ManualPumpValueTextBlock" Text="0 %" Foreground="LightGray"/>
                                <Slider x:Name="ManualPumpSlider" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="ManualSlider_ValueChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="Vent Valve [%]" Foreground="White"/>
                                <TextBlock x:Name="ManualVentValveValueTextBlock" Text="0 %" Foreground="LightGray"/>
                                <Slider x:Name="ManualVentValveSlider" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="ManualSlider_ValueChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="Fan Speed [%]" Foreground="White"/>
                                <TextBlock x:Name="ManualFanValueTextBlock" Text="70 %" Foreground="LightGray"/>
                                <Slider x:Name="ManualFanSlider" Minimum="0" Maximum="100" Value="70"
                                        ValueChanged="ManualSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShowDisturbancesButton"
                            Grid.Column="0"
                            Content="EXPERIMENT"
                            Height="42"
                            FontWeight="Bold"
                            Background="#9A6700"
                            BorderBrush="#D99A1D"
                            Foreground="White"
                            Margin="0,0,5,0"
                            ToolTip="Open experimental disturbance controls."
                            Click="ShowDisturbancesButton_Click"/>

                    <Button x:Name="ExitButton"
                            Grid.Column="1"
                            Content="EXIT"
                            Height="42"
                            FontWeight="Bold"
                            Background="#424242"
                            Foreground="White"
                            Margin="5,0,0,0"
                            Click="ExitButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
